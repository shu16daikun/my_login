<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.7</version>
    <relativePath></relativePath>
  </parent>

  <groupId>com.login</groupId>
  <artifactId>my_login</artifactId>
  <version>0.2.0</version>
  <name>my_login</name>
  <description>Login module (library)</description>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <maven-compiler-plugin.version>3.11.0</maven-compiler-plugin.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!-- 自作モジュール -->
    <my_util.version>0.1.1</my_util.version>
    <my_exception.version>0.0.4</my_exception.version>
    <my_loger.version>0.0.1</my_loger.version>

    <!-- Spotless -->
    <spotless.version>2.44.0</spotless.version>

    <!-- Lombok（コンパイル時のみ必要なら残す） -->
    <lombok.version>1.18.42</lombok.version>
  </properties>

  <dependencies>
    <!-- 自モジュール依存 -->
    <dependency>
      <groupId>com.my.util</groupId>
      <artifactId>my_util</artifactId>
      <version>${my_util.version}</version>
    </dependency>
    <dependency>
      <groupId>com.my.exception</groupId>
      <artifactId>my_exception</artifactId>
      <version>${my_exception.version}</version>
    </dependency>

    <!-- Spring Boot -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- Lombok（Spotless からは独立） -->
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <scope>provided</scope>
      <optional>true</optional>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Java compile -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <release>${maven.compiler.release}</release>
          <parameters>true</parameters>
          <annotationProcessorPaths>
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
              <version>${lombok.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>

      <!-- Spring Boot：ライブラリなので repackage はスキップ -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <skip>true</skip>
          <excludes>
            <exclude>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
            </exclude>
          </excludes>
        </configuration>
      </plugin>

      <!-- Spotless：Eclipse JDT フォーマッタに統一 -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless.version}</version>
        <configuration>
          <lineEndings>UNIX</lineEndings>
          <encoding>UTF-8</encoding>

          <java>
            <eclipse>
              <file>${basedir}/.eclipse/formatter/eclipse-java-formatter.xml</file>
            </eclipse>
            <removeUnusedImports></removeUnusedImports>
            <includes>
              <include>src/main/java/**/*.java</include>
              <include>src/test/java/**/*.java</include>
            </includes>
          </java>

          <formats>
            <format>
              <includes>
                <include>src/**/*.xml</include>
              </includes>
              <eclipseWtp>
                <type>XML</type>
              </eclipseWtp>
            </format>
          </formats>

          <pom>
            <sortPom></sortPom>
          </pom>
        </configuration>
        <executions>
          <execution>
            <id>spotless-check</id>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>verify</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Web資産がある時だけ ON（Java設定は上書きせず formats だけ追加） -->
    <profile>
      <id>with-prettier</id>
      <properties>
        <prettier.config.file>${project.basedir}/.prettierrc.json</prettier.config.file>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>com.diffplug.spotless</groupId>
            <artifactId>spotless-maven-plugin</artifactId>
            <version>${spotless.version}</version>
            <configuration>
              <formats>
                <format>
                  <includes>
                    <include>src/**/*.js</include>
                    <include>src/**/*.ts</include>
                    <include>src/**/*.css</include>
                    <include>src/**/*.scss</include>
                    <include>src/**/*.html</include>
                    <include>src/**/*.json</include>
                  </includes>
                  <prettier>
                    <configFile>${prettier.config.file}</configFile>
                  </prettier>
                </format>
              </formats>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
