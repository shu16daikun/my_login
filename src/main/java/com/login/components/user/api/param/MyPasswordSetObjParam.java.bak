package com.login.components.user.api.param;

import lombok.AccessLevel;
import lombok.NoArgsConstructor;

/**
 * パスワード設定画面の Model 属性名（ビュー間受け渡しのキーを集中管理）
 *
 * <p>テンプレートから参照する key 名。外部仕様のためリネーム時は影響範囲に注意。
 */
/* ===== [public/protected] START ===== */
@NoArgsConstructor(access = AccessLevel.PRIVATE)
public class MyPasswordSetObjParam {
  /** 単一DTO：{@code "passwordSetViewDto"} */
  public static final String VIEW_DTO = "passwordSetViewDto";

  /** 複数DTO：{@code "passwordSetViewDtoList"} */
  public static final String VIEW_DTO_LIST = "passwordSetViewDtoList";
}
/* ===== [public/protected] END ===== */
